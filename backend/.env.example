# ==============================================================================
# Catalyst V2 Backend Environment Configuration (.env.example)
# ==============================================================================

# Server
PORT=8000
HOST=0.0.0.0

# Database Configuration (Supabase PostgreSQL / pgvector)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:54322/supabase_local

# Supabase API & Auth Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Primary LLM Provider: Groq (Llama-3.3-70b-versatile)
# Used by LangGraph multi-agent orchestration and Campaign Studio
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback LLM & RAG Embeddings Provider (OpenAI)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Email Provider Configuration (Resend)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=Catalyst CRM
EMAIL_REPLY_TO=support@yourdomain.com
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret_here

# LangSmith Observability & Tracing (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=catalyst-crm
