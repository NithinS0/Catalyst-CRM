# ==========================================
# CATALYST V2 CRM — PRODUCTION ENVIRONMENT
# ==========================================

# ── 1. SUPABASE DATABASE & AUTH (REQUIRED) ──
# Project Ref: pmuxilssbyurlotubvlg
SUPABASE_URL=https://pmuxilssbyurlotubvlg.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here
DATABASE_URL=postgresql://postgres.pmuxilssbyurlotubvlg:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# ── 2. LLM INFERENCE APIS (REQUIRED) ──
# Main API: Groq (Recommended: fast, low-latency agent execution)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=groq/compound-mini

# Optional LLM Fallback: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── 3. EMAIL PROVIDERS (OPTIONAL / PRODUCTION) ──
EMAIL_PROVIDER=resend
RESEND_API_KEY=your-resend-api-key-here
EMAIL_FROM=notifications@yourdomain.com
EMAIL_FROM_NAME=Catalyst CRM
EMAIL_REPLY_TO=support@yourdomain.com
RESEND_WEBHOOK_SECRET=

# ── 4. LANGSMITH TELEMETRY (OPTIONAL) ──
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=catalyst-crm

# ── 5. FRONTEND VERCEL CONFIGURATION ──
# Deployed URL of FastAPI backend (or set to your Vercel URL if using serverless rewrites)
NEXT_PUBLIC_API_URL=https://your-backend-service.up.railway.app
BACKEND_INTERNAL_URL=https://your-backend-service.up.railway.app
